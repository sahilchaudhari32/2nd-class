# 7C Second Chance Market - Environment Variables Example
# Duplicate this file to .env and customize values for your deployment.

# Relational Database Connection (PostgreSQL or SQLite file)
DATABASE_URL="file:./dev.db"
POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/secondchance?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-32-character-secret-in-production"

# Initial Seed Admin Credentials
ADMIN_EMAIL="admin@2ndclass.com"
ADMIN_PASSWORD="admin_secure_password"
ADMIN_NAME="Administrator"

# Storage Configuration (Cloudinary or local fallback)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
